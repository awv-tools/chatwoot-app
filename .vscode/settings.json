{
  "rubyLsp.rubyVersionManager": {
    "identifier": "rbenv"
  },
  "rubyLsp.bundleGemfile": "${workspaceFolder}/Gemfile",
  "rubyLsp.customRubyCommand": null,
  "rubyLsp.enableExperimentalFeatures": true,
  "rubyLsp.featuresConfiguration": {
    "documentSymbol": {
      "enabled": true
    },
    "hover": {
      "enabled": true
    },
    "definition": {
      "enabled": true
    },
    "inlayHint": {
      "implicitHashValue": true,
      "implicitRescue": true
    }
  }
}
